# ─────────────────────────────────────────────────────────────
# VENTUREX environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Public base URL (no trailing slash). Used for emails, OAuth callbacks, sitemap, webhooks.
APP_URL=http://localhost:3000

# PostgreSQL connection string
# For local dev without Postgres installed: `npm run db:local` then use:
DATABASE_URL=postgresql://venturex:venturex@localhost:5433/venturex

# Secret used to sign OAuth state and other short-lived values (32+ random chars)
AUTH_SECRET=change-me-to-a-long-random-string

# Shared secret for the scheduler endpoint (/api/cron/tick). Send as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=change-me-too

# ── Google sign-in (optional) ─────────────────────────────────
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) ──────────────────────────────────────────────
# Any SMTP provider (Postmark, SES, Mailgun, Resend SMTP...). Without it, emails are
# printed to the server console in development and logged as errors in production.
SMTP_URL=
EMAIL_FROM="VENTUREX <no-reply@venturex.example>"

# ── Payments ──────────────────────────────────────────────────
# PAYMENT_PROVIDER: "stripe" (Stripe Connect) or "sandbox" (development only, refuses to run in production)
PAYMENT_PROVIDER=sandbox
# Stripe — use TEST keys (sk_test_...) until you have completed Stripe's marketplace review.
# Stripe Connect must be available in the country where your platform entity is registered.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Connected-account country for seller onboarding (ISO code), e.g. US, GB, DE
STRIPE_CONNECT_COUNTRY=US

# ── Escrow for high-value sales (optional but recommended) ────
# Escrow.com API (https://www.escrow.com/api). Use the sandbox host while testing.
ESCROW_API_URL=https://api.escrow-sandbox.com/2017-09-01
ESCROW_EMAIL=
ESCROW_API_KEY=

# ── File storage ──────────────────────────────────────────────
# S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
# Leave empty in development to store files under ./storage on disk.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI valuation (optional) ───────────────────────────────────
# With a key, the valuation tool adds an AI-written analysis on top of the
# deterministic multiple-based model. Without it, only the model is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ── Exchange rates ────────────────────────────────────────────
# JSON endpoint returning { rates: { GEL: n, EUR: n, RUB: n } } relative to USD.
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/USD
